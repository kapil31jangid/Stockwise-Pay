# StockWise Pay Backend Environment Configuration

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL is required for real payment execution. If omitted, only explicit local/test simulation is available.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/stockwise_pay

# PayPal Developer Sandbox Credentials
# Register at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Set true only for an explicit non-payment demo or automated test environment.
PAYPAL_SIMULATION_ENABLED=false

# Optional AI LLM API (reserved for future freeform conversational answers)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

